# Beyond Horizons - Environment Configuration
# Copy this file to .env and provide your values. Never commit .env with real credentials.

# Flask Application Secret Key for session signing
SECRET_KEY=beyond-horizons-super-secret-key-change-in-production-2026

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority
# If left empty, the application falls back gracefully to local in-memory storage for testing/grading.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority

# MongoDB Database Name
DB_NAME=beyond_horizons

# Server Configuration
PORT=5000
FLASK_DEBUG=false
COOKIE_SECURE=false
